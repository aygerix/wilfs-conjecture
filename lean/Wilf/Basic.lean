import Mathlib.NumberTheory.FrobeniusNumber
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Order.Lattice.Nat
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Push

/-!
# Numerical semigroups: foundations for Wilf's conjecture

A numerical semigroup is an additive submonoid `S` of `ℕ` whose complement `ℕ \ S` is finite.
(`S = ℕ` is allowed.)

Main definitions (all for `S : NumericalSemigroup`):
* `S.conductor`    : least `c` with `∀ n ≥ c, n ∈ S`              (`c(S)`)
* `S.gaps`         : finset of `n ∉ S`;  `S.genus = S.gaps.card`  (`g(S)`)
* `S.left`         : finset of `n ∈ S` with `n < c`; `S.ell = S.left.card` (`ℓ(S)`)
* `S.multiplicity` : least positive element of `S`                (`m(S)`)
* `S.IsPrimitive n`: `n ∈ S`, `0 < n`, and `n` is not a sum of two positive elements of `S`
* `S.primitives`   : finset of primitive elements;  `S.embDim = S.primitives.card`  (`e(S)`)
* `S.apery n i`    : least element of `S` congruent to `i` mod `n` (meaningful for `0 < n`)
* `S.kunz i`       : Kunz coordinate `(w_i - i) / m` with `w_i = S.apery m i`, `m = S.multiplicity`
* `WilfConjecture  : ∀ S, S.conductor ≤ S.embDim * S.ell`
-/

/-- A **numerical semigroup**: an additive submonoid of `ℕ` with finite complement. -/
structure NumericalSemigroup extends AddSubmonoid ℕ where
  finite_compl : (carrierᶜ : Set ℕ).Finite

namespace NumericalSemigroup

instance : SetLike NumericalSemigroup ℕ where
  coe S := S.carrier
  coe_injective S T h := by
    rcases S with ⟨⟨⟨s, _⟩, _⟩, _⟩
    rcases T with ⟨⟨⟨t, _⟩, _⟩, _⟩
    simp only at h
    subst h
    rfl

instance : AddSubmonoidClass NumericalSemigroup ℕ where
  add_mem {S} := S.add_mem'
  zero_mem S := S.zero_mem'

variable (S : NumericalSemigroup)

@[simp] theorem mem_carrier {n : ℕ} : n ∈ S.carrier ↔ n ∈ S := Iff.rfl

@[simp] theorem mem_toAddSubmonoid {n : ℕ} : n ∈ S.toAddSubmonoid ↔ n ∈ S := Iff.rfl

@[ext] theorem ext {S T : NumericalSemigroup} (h : ∀ n, n ∈ S ↔ n ∈ T) : S = T :=
  SetLike.ext h

theorem finite_setOf_not_mem : {n : ℕ | n ∉ S}.Finite := S.finite_compl

/-! ### Constructors -/

/-- Build a numerical semigroup from a predicate that contains `0`, is closed under addition,
and holds for all `n ≥ N`. -/
def ofPred (p : ℕ → Prop) (h0 : p 0) (hadd : ∀ a b, p a → p b → p (a + b)) (N : ℕ)
    (hN : ∀ n, N ≤ n → p n) : NumericalSemigroup where
  carrier := {n | p n}
  add_mem' := fun ha hb => hadd _ _ ha hb
  zero_mem' := h0
  finite_compl := (Set.finite_lt_nat N).subset fun n hn => by
    by_contra h
    exact hn (hN n (Nat.le_of_not_lt h))

@[simp] theorem mem_ofPred {p : ℕ → Prop} {h0 hadd N hN} {n : ℕ} :
    n ∈ ofPred p h0 hadd N hN ↔ p n := Iff.rfl

/-- The numerical semigroup generated by a set `A` of naturals with `gcd A = 1`. -/
noncomputable def ofClosure (A : Set ℕ) (hA : Nat.setGcd A = 1) : NumericalSemigroup where
  toAddSubmonoid := AddSubmonoid.closure A
  finite_compl := by
    obtain ⟨N, hN⟩ := Nat.exists_mem_closure_of_ge A
    refine (Set.finite_lt_nat N).subset fun n hn => ?_
    by_contra h
    exact hn (hN n (Nat.le_of_not_lt h) (by rw [hA]; exact one_dvd n))

theorem mem_ofClosure {A : Set ℕ} {hA : Nat.setGcd A = 1} {n : ℕ} :
    n ∈ ofClosure A hA ↔ n ∈ AddSubmonoid.closure A := Iff.rfl

/-- The trivial numerical semigroup `ℕ` itself. -/
def nat : NumericalSemigroup where
  toAddSubmonoid := ⊤
  finite_compl := by
    show (Set.univᶜ : Set ℕ).Finite
    simp

@[simp] theorem mem_nat (n : ℕ) : n ∈ nat := trivial

/-! ### Conductor -/

theorem exists_forall_ge_mem : ∃ c, ∀ n, c ≤ n → n ∈ S := by
  obtain ⟨N, hN⟩ := S.finite_compl.bddAbove
  refine ⟨N + 1, fun n hn => ?_⟩
  by_contra h
  have : n ≤ N := hN (show n ∈ (S.carrier)ᶜ from h)
  omega

/-- The **conductor** `c(S)`: least `c` such that every `n ≥ c` lies in `S`. -/
noncomputable def conductor : ℕ := sInf {c | ∀ n, c ≤ n → n ∈ S}

theorem mem_of_conductor_le {n : ℕ} (h : S.conductor ≤ n) : n ∈ S :=
  Nat.sInf_mem S.exists_forall_ge_mem n h

theorem conductor_le_of {c : ℕ} (h : ∀ n, c ≤ n → n ∈ S) : S.conductor ≤ c :=
  Nat.sInf_le h

theorem lt_conductor_of_not_mem {n : ℕ} (h : n ∉ S) : n < S.conductor := by
  by_contra h'
  exact h (S.mem_of_conductor_le (Nat.le_of_not_lt h'))

/-- The Frobenius number `c - 1` is a gap (when `c > 0`). -/
theorem conductor_sub_one_not_mem (hc : 0 < S.conductor) : S.conductor - 1 ∉ S := by
  intro hm
  have : S.conductor ≤ S.conductor - 1 := S.conductor_le_of fun n hn => by
    rcases Nat.eq_or_lt_of_le hn with h | h
    · exact h ▸ hm
    · exact S.mem_of_conductor_le (by omega)
  omega

theorem conductor_eq_iff {c : ℕ} :
    S.conductor = c ↔ (∀ n, c ≤ n → n ∈ S) ∧ (0 < c → c - 1 ∉ S) := by
  constructor
  · rintro rfl
    exact ⟨fun n hn => S.mem_of_conductor_le hn, S.conductor_sub_one_not_mem⟩
  · rintro ⟨h1, h2⟩
    apply le_antisymm (S.conductor_le_of h1)
    by_contra hlt
    push Not at hlt
    exact h2 (by omega) (S.mem_of_conductor_le (by omega))

/-! ### Gaps and genus -/

/-- The finset of gaps `ℕ \ S`. -/
noncomputable def gaps : Finset ℕ := S.finite_compl.toFinset

@[simp] theorem mem_gaps {n : ℕ} : n ∈ S.gaps ↔ n ∉ S := by
  simp [gaps]

/-- The **genus** `g(S) = |ℕ \ S|`. -/
noncomputable def genus : ℕ := S.gaps.card

/-! ### Left elements -/

theorem finite_left : {n : ℕ | n ∈ S ∧ n < S.conductor}.Finite :=
  (Set.finite_lt_nat S.conductor).subset fun _ hn => hn.2

/-- The finset `L(S) = S ∩ [0, c)` of **left elements**. -/
noncomputable def left : Finset ℕ := S.finite_left.toFinset

@[simp] theorem mem_left {n : ℕ} : n ∈ S.left ↔ n ∈ S ∧ n < S.conductor := by
  simp [left]

/-- `ℓ(S) = |S ∩ [0, c)|`. -/
noncomputable def ell : ℕ := S.left.card

theorem gaps_subset_range : S.gaps ⊆ Finset.range S.conductor := fun n hn => by
  rw [mem_gaps] at hn
  exact Finset.mem_range.2 (S.lt_conductor_of_not_mem hn)

theorem left_union_gaps : S.left ∪ S.gaps = Finset.range S.conductor := by
  ext n
  simp only [Finset.mem_union, mem_left, mem_gaps, Finset.mem_range]
  constructor
  · rintro (h | h)
    · exact h.2
    · exact S.lt_conductor_of_not_mem h
  · intro h
    by_cases hn : n ∈ S
    · exact Or.inl ⟨hn, h⟩
    · exact Or.inr hn

theorem disjoint_left_gaps : Disjoint S.left S.gaps :=
  Finset.disjoint_left.2 fun _ h1 h2 => (S.mem_gaps.1 h2) (S.mem_left.1 h1).1

/-- **`ℓ + g = c`.** -/
theorem ell_add_genus : S.ell + S.genus = S.conductor := by
  rw [ell, genus, ← Finset.card_union_of_disjoint S.disjoint_left_gaps, left_union_gaps,
    Finset.card_range]

theorem ell_eq : S.ell = S.conductor - S.genus := by
  have := S.ell_add_genus; omega

theorem genus_le_conductor : S.genus ≤ S.conductor := by
  have := S.ell_add_genus; omega

/-! ### Multiplicity -/

theorem exists_pos_mem : ∃ n, 0 < n ∧ n ∈ S :=
  ⟨S.conductor + 1, Nat.succ_pos _, S.mem_of_conductor_le (Nat.le_succ _)⟩

/-- The **multiplicity** `m(S)`: least positive element of `S`. -/
noncomputable def multiplicity : ℕ := sInf {n | 0 < n ∧ n ∈ S}

theorem multiplicity_spec : 0 < S.multiplicity ∧ S.multiplicity ∈ S :=
  Nat.sInf_mem S.exists_pos_mem

theorem multiplicity_pos : 0 < S.multiplicity := S.multiplicity_spec.1

theorem multiplicity_mem : S.multiplicity ∈ S := S.multiplicity_spec.2

theorem multiplicity_le {n : ℕ} (h0 : 0 < n) (h : n ∈ S) : S.multiplicity ≤ n :=
  Nat.sInf_le ⟨h0, h⟩

theorem multiplicity_eq_of {m : ℕ} (h0 : 0 < m) (hm : m ∈ S)
    (hlt : ∀ n, 0 < n → n < m → n ∉ S) : S.multiplicity = m := by
  apply le_antisymm (S.multiplicity_le h0 hm)
  by_contra h
  exact hlt _ S.multiplicity_pos (by omega) S.multiplicity_mem

theorem not_mem_of_pos_of_lt_multiplicity {n : ℕ} (h0 : 0 < n) (h : n < S.multiplicity) :
    n ∉ S := fun hn => absurd (S.multiplicity_le h0 hn) (by omega)

theorem multiplicity_le_conductor_add_one : S.multiplicity ≤ S.conductor + 1 :=
  S.multiplicity_le (Nat.succ_pos _) (S.mem_of_conductor_le (Nat.le_succ _))

/-! ### Primitive elements (minimal generators) and embedding dimension -/

/-- `n` is **primitive** (a minimal generator): a positive element of `S` that is not the sum
of two positive elements of `S`. -/
def IsPrimitive (n : ℕ) : Prop :=
  n ∈ S ∧ 0 < n ∧ ∀ a ∈ S, ∀ b ∈ S, 0 < a → 0 < b → a + b ≠ n

theorem exists_decomp_of_not_isPrimitive {n : ℕ} (hn : n ∈ S) (h0 : 0 < n)
    (h : ¬ S.IsPrimitive n) : ∃ a ∈ S, ∃ b ∈ S, 0 < a ∧ 0 < b ∧ a + b = n := by
  unfold IsPrimitive at h
  push Not at h
  exact h hn h0

theorem isPrimitive_multiplicity : S.IsPrimitive S.multiplicity := by
  refine ⟨S.multiplicity_mem, S.multiplicity_pos, fun a ha b hb a0 b0 hab => ?_⟩
  have h1 := S.multiplicity_le a0 ha
  have h2 := S.multiplicity_le b0 hb
  have := S.multiplicity_pos
  omega

/-- Every primitive element is `< c + m + 1` (a crude bound giving finiteness). -/
theorem IsPrimitive.lt_conductor_add_multiplicity_add_one {n : ℕ} (h : S.IsPrimitive n) :
    n < S.conductor + S.multiplicity + 1 := by
  by_contra hc
  push Not at hc
  exact h.2.2 (n - S.multiplicity) (S.mem_of_conductor_le (by omega)) S.multiplicity
    S.multiplicity_mem (by omega) S.multiplicity_pos (by omega)

theorem finite_primitives : {n : ℕ | S.IsPrimitive n}.Finite :=
  (Set.finite_lt_nat _).subset fun _ hn => IsPrimitive.lt_conductor_add_multiplicity_add_one S hn

/-- The finset of primitive elements (minimal generators). -/
noncomputable def primitives : Finset ℕ := S.finite_primitives.toFinset

@[simp] theorem mem_primitives {n : ℕ} : n ∈ S.primitives ↔ S.IsPrimitive n := by
  simp [primitives]

/-- The **embedding dimension** `e(S)`: the number of primitive elements. -/
noncomputable def embDim : ℕ := S.primitives.card

/-- Induction principle: a property holding at `0`, at every primitive, and closed under sums of
elements of `S` holds on all of `S`. -/
theorem mem_induction {P : ℕ → Prop} (h0 : P 0) (hp : ∀ p, S.IsPrimitive p → P p)
    (hadd : ∀ a b, a ∈ S → b ∈ S → P a → P b → P (a + b)) {n : ℕ} (hn : n ∈ S) : P n := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases Nat.eq_zero_or_pos n with rfl | hpos
    · exact h0
    by_cases hprim : S.IsPrimitive n
    · exact hp n hprim
    obtain ⟨a, ha, b, hb, a0, b0, rfl⟩ := S.exists_decomp_of_not_isPrimitive hn hpos hprim
    exact hadd a b ha hb (ih a (by omega) ha) (ih b (by omega) hb)

/-- `S` is generated by its primitive elements. -/
theorem closure_primitives :
    AddSubmonoid.closure (S.primitives : Set ℕ) = S.toAddSubmonoid := by
  apply le_antisymm
  · rw [AddSubmonoid.closure_le]
    intro n hn
    exact (S.mem_primitives.1 hn).1
  · intro n hn
    refine S.mem_induction (P := fun n => n ∈ AddSubmonoid.closure (S.primitives : Set ℕ))
      (AddSubmonoid.zero_mem _) (fun p hp => AddSubmonoid.subset_closure ?_)
      (fun a b _ _ ha hb => AddSubmonoid.add_mem _ ha hb) hn
    exact S.mem_primitives.2 hp

/-- Every generating set of `S` contains all primitive elements; hence `primitives` is the unique
minimal generating set and `embDim` is the embedding dimension. -/
theorem primitives_subset_of_closure_eq {A : Set ℕ}
    (hA : AddSubmonoid.closure A = S.toAddSubmonoid) : (S.primitives : Set ℕ) ⊆ A := by
  intro p hp
  have hp := S.mem_primitives.1 hp
  have hmem : p ∈ AddSubmonoid.closure A := by rw [hA]; exact hp.1
  have key : ∀ x ∈ AddSubmonoid.closure A,
      x = 0 ∨ x ∈ A ∨ ∃ a ∈ S, ∃ b ∈ S, 0 < a ∧ 0 < b ∧ a + b = x := by
    intro x hx
    induction hx using AddSubmonoid.closure_induction with
    | mem x hx => exact Or.inr (Or.inl hx)
    | zero => exact Or.inl rfl
    | add x y hx hy ihx ihy =>
      have hxS : x ∈ S := by rw [hA] at hx; exact hx
      have hyS : y ∈ S := by rw [hA] at hy; exact hy
      rcases Nat.eq_zero_or_pos x with rfl | x0
      · rw [zero_add]; exact ihy
      rcases Nat.eq_zero_or_pos y with rfl | y0
      · rw [add_zero]; exact ihx
      exact Or.inr (Or.inr ⟨x, hxS, y, hyS, x0, y0, rfl⟩)
  rcases key p hmem with h | h | ⟨a, ha, b, hb, a0, b0, hab⟩
  · exact absurd h hp.2.1.ne'
  · exact h
  · exact absurd hab (hp.2.2 a ha b hb a0 b0)

/-- Distinct primitive elements are incongruent modulo the multiplicity. -/
theorem IsPrimitive.eq_of_mod_eq {p q : ℕ} (hp : S.IsPrimitive p) (hq : S.IsPrimitive q)
    (h : p % S.multiplicity = q % S.multiplicity) : p = q := by
  -- reduce to `p ≤ q`
  have key : ∀ p q, S.IsPrimitive p → S.IsPrimitive q →
      p % S.multiplicity = q % S.multiplicity → p ≤ q → p = q := by
    intro p q hp hq h hle
    by_contra hne
    have hlt : p < q := lt_of_le_of_ne hle hne
    obtain ⟨k, hk⟩ : S.multiplicity ∣ q - p :=
      Nat.dvd_of_mod_eq_zero (Nat.sub_mod_eq_zero_of_mod_eq h.symm)
    have m0 := S.multiplicity_pos
    have hk0 : k ≠ 0 := by rintro rfl; omega
    have hmk : S.multiplicity * (k - 1) = S.multiplicity * k - S.multiplicity := Nat.mul_sub_one _ _
    have hle' : S.multiplicity ≤ S.multiplicity * k := Nat.le_mul_of_pos_right _ (by omega)
    have hmem : q - S.multiplicity ∈ S := by
      have : q - S.multiplicity = p + (k - 1) • S.multiplicity := by
        rw [smul_eq_mul, mul_comm]; omega
      rw [this]
      exact add_mem hp.1 (nsmul_mem S.multiplicity_mem _)
    exact hq.2.2 (q - S.multiplicity) hmem S.multiplicity S.multiplicity_mem
      (by have := hp.2.1; omega) m0 (by omega)
  rcases le_total p q with hle | hle
  · exact key p q hp hq h hle
  · exact (key q p hq hp h.symm hle).symm

/-- **`e ≤ m`.** -/
theorem embDim_le_multiplicity : S.embDim ≤ S.multiplicity := by
  have := Finset.card_le_card_of_injOn (s := S.primitives) (t := Finset.range S.multiplicity)
    (fun n => n % S.multiplicity)
    (fun n _ => by simpa using Nat.mod_lt n S.multiplicity_pos)
    (fun p hp q hq h => IsPrimitive.eq_of_mod_eq S (S.mem_primitives.1 hp)
      (S.mem_primitives.1 hq) h)
  simpa [embDim] using this

theorem multiplicity_mem_primitives : S.multiplicity ∈ S.primitives :=
  S.mem_primitives.2 S.isPrimitive_multiplicity

theorem embDim_pos : 0 < S.embDim :=
  Finset.card_pos.2 ⟨_, S.multiplicity_mem_primitives⟩

/-- If `d` divides every primitive element then `d` divides every element of `S`. -/
theorem dvd_of_forall_primitive_dvd {d : ℕ} (hd : ∀ p, S.IsPrimitive p → d ∣ p) {n : ℕ}
    (hn : n ∈ S) : d ∣ n :=
  S.mem_induction (dvd_zero d) hd (fun _ _ _ _ ha hb => dvd_add ha hb) hn

/-! ### The trivial semigroup `ℕ` -/

theorem multiplicity_eq_one_iff : S.multiplicity = 1 ↔ S = nat := by
  constructor
  · intro h
    have h1 : (1 : ℕ) ∈ S := h ▸ S.multiplicity_mem
    ext n
    simp only [mem_nat, iff_true]
    have := nsmul_mem h1 n
    simpa using this
  · rintro rfl
    have := nat.multiplicity_le one_pos (mem_nat 1)
    have := nat.multiplicity_pos
    omega

theorem conductor_eq_zero_iff : S.conductor = 0 ↔ S = nat := by
  constructor
  · intro h
    ext n
    simp only [mem_nat, iff_true]
    exact S.mem_of_conductor_le (by omega)
  · rintro rfl
    exact Nat.le_zero.1 (nat.conductor_le_of fun n _ => mem_nat n)

theorem conductor_pos_iff : 0 < S.conductor ↔ S ≠ nat := by
  rw [Nat.pos_iff_ne_zero, Ne, conductor_eq_zero_iff]

theorem one_lt_multiplicity_iff : 1 < S.multiplicity ↔ S ≠ nat := by
  rw [Ne, ← multiplicity_eq_one_iff]
  have := S.multiplicity_pos
  omega

@[simp] theorem nat_conductor : nat.conductor = 0 := (conductor_eq_zero_iff nat).2 rfl

@[simp] theorem nat_multiplicity : nat.multiplicity = 1 := (multiplicity_eq_one_iff nat).2 rfl

@[simp] theorem nat_gaps : nat.gaps = ∅ := by
  ext n; simp

@[simp] theorem nat_genus : nat.genus = 0 := by simp [genus]

@[simp] theorem nat_left : nat.left = ∅ := by
  ext n; simp

@[simp] theorem nat_ell : nat.ell = 0 := by simp [ell]

@[simp] theorem nat_primitives : nat.primitives = {1} := by
  ext n
  simp only [mem_primitives, Finset.mem_singleton]
  constructor
  · intro h
    by_contra hn
    exact h.2.2 1 (mem_nat 1) (n - 1) (mem_nat _) one_pos (by have := h.2.1; omega)
      (by have := h.2.1; omega)
  · rintro rfl
    simpa using nat.isPrimitive_multiplicity

@[simp] theorem nat_embDim : nat.embDim = 1 := by simp [embDim]

/-- For `S ≠ ℕ`, there are at least two primitive elements: **`e ≥ 2`**. -/
theorem two_le_embDim (hS : S ≠ nat) : 2 ≤ S.embDim := by
  by_contra hlt
  push Not at hlt
  have hm1 : 1 < S.multiplicity := (S.one_lt_multiplicity_iff).2 hS
  -- the only primitive is `m`
  have hall : ∀ p, S.IsPrimitive p → p = S.multiplicity := by
    intro p hp
    have hcard : S.primitives.card ≤ 1 := by unfold embDim at hlt; omega
    exact Finset.card_le_one.1 hcard p (S.mem_primitives.2 hp) _ S.multiplicity_mem_primitives
  have hdvd : ∀ n ∈ S, S.multiplicity ∣ n := fun n hn =>
    S.dvd_of_forall_primitive_dvd (fun p hp => by rw [hall p hp]) hn
  have hmem : S.multiplicity * (S.conductor + 1) + 1 ∈ S :=
    S.mem_of_conductor_le (by nlinarith [S.multiplicity_pos])
  have h1 := hdvd _ hmem
  have h2 : S.multiplicity ∣ 1 := (Nat.dvd_add_right (dvd_mul_right _ _)).1 h1
  have := Nat.le_of_dvd one_pos h2
  omega

/-! ### Wilf's conjecture -/

/-- **Wilf's conjecture** (1978): for every numerical semigroup, `c(S) ≤ e(S) · ℓ(S)`. -/
def WilfConjecture : Prop :=
  ∀ S : NumericalSemigroup, S.conductor ≤ S.embDim * S.ell

/-- The natural-number form agrees with the integer form `e·(c - g) - c ≥ 0` (no truncated
subtraction involved). -/
theorem wilf_iff_int :
    S.conductor ≤ S.embDim * S.ell ↔
      0 ≤ (S.embDim : ℤ) * ((S.conductor : ℤ) - (S.genus : ℤ)) - (S.conductor : ℤ) := by
  have h := S.ell_add_genus
  have h' : (S.conductor : ℤ) - (S.genus : ℤ) = (S.ell : ℤ) := by omega
  rw [h', sub_nonneg]
  exact_mod_cast Iff.rfl

theorem wilfConjecture_iff_int :
    WilfConjecture ↔ ∀ S : NumericalSemigroup,
      0 ≤ (S.embDim : ℤ) * ((S.conductor : ℤ) - (S.genus : ℤ)) - (S.conductor : ℤ) :=
  forall_congr' fun S => S.wilf_iff_int

theorem wilf_nat : nat.conductor ≤ nat.embDim * nat.ell := by simp

/-! ### `2ℓ ≤ c` in general, and Wilf when `c ≤ 2ℓ` (symmetric case) -/

/-- For `x ∈ S` with `x < c`, the reflection `c - 1 - x` is a gap. -/
theorem reflect_not_mem {x : ℕ} (hx : x ∈ S) (hlt : x < S.conductor) :
    S.conductor - 1 - x ∉ S := by
  intro h
  apply S.conductor_sub_one_not_mem (by omega)
  have := add_mem hx h
  rwa [show x + (S.conductor - 1 - x) = S.conductor - 1 by omega] at this

/-- **`2ℓ ≤ c`**, equivalently `ℓ ≤ g`. -/
theorem ell_le_genus : S.ell ≤ S.genus := by
  apply Finset.card_le_card_of_injOn (fun x => S.conductor - 1 - x)
  · intro x hx
    simp only [Finset.mem_coe, mem_left, mem_gaps] at hx ⊢
    exact S.reflect_not_mem hx.1 hx.2
  · intro x hx y hy h
    simp only [Finset.mem_coe, mem_left] at hx hy
    simp only at h
    omega

theorem two_mul_ell_le_conductor : 2 * S.ell ≤ S.conductor := by
  have := S.ell_add_genus; have := S.ell_le_genus; omega

/-- Wilf's inequality holds whenever `c ≤ 2ℓ`. -/
theorem wilf_of_conductor_le_two_mul_ell (h : S.conductor ≤ 2 * S.ell) :
    S.conductor ≤ S.embDim * S.ell := by
  by_cases hS : S = nat
  · subst hS; simp
  · exact h.trans (Nat.mul_le_mul_right _ (S.two_le_embDim hS))

/-- `S` is **symmetric** if for every gap `x` (necessarily `x < c`), `c - 1 - x ∈ S`
(i.e. `x ∉ S ⇒ F - x ∈ S` with Frobenius number `F = c - 1`). `ℕ` is (vacuously) symmetric. -/
def IsSymmetric : Prop := ∀ x, x < S.conductor → x ∉ S → S.conductor - 1 - x ∈ S

theorem IsSymmetric.genus_le_ell (h : S.IsSymmetric) : S.genus ≤ S.ell := by
  apply Finset.card_le_card_of_injOn (fun x => S.conductor - 1 - x)
  · intro x hx
    simp only [Finset.mem_coe, mem_left, mem_gaps] at hx ⊢
    have := S.lt_conductor_of_not_mem hx
    exact ⟨h x this hx, by omega⟩
  · intro x hx y hy hxy
    simp only [Finset.mem_coe, mem_gaps] at hx hy
    have := S.lt_conductor_of_not_mem hx
    have := S.lt_conductor_of_not_mem hy
    simp only at hxy
    omega

theorem IsSymmetric.conductor_eq (h : S.IsSymmetric) : S.conductor = 2 * S.ell := by
  have := S.ell_add_genus; have := S.ell_le_genus; have := h.genus_le_ell; omega

theorem isSymmetric_iff : S.IsSymmetric ↔ S.conductor = 2 * S.ell := by
  refine ⟨fun h => h.conductor_eq, fun hc => ?_⟩
  -- the reflection maps `left` injectively into `gaps`, and the cards agree, so it is onto
  have hcard : S.ell = S.genus := by have := S.ell_add_genus; omega
  set f : ℕ → ℕ := fun x => S.conductor - 1 - x with hf
  have hsub : S.left.image f ⊆ S.gaps := by
    intro y hy
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.1 hy
    rw [mem_left] at hx
    exact S.mem_gaps.2 (S.reflect_not_mem hx.1 hx.2)
  have hinj : Set.InjOn f (S.left : Set ℕ) := by
    intro x hx y hy hxy
    simp only [Finset.mem_coe, mem_left] at hx hy
    simp only [hf] at hxy
    omega
  have himg : (S.left.image f).card = S.genus := by
    rw [Finset.card_image_of_injOn hinj]; exact hcard
  have heq : S.left.image f = S.gaps := Finset.eq_of_subset_of_card_le hsub (by rw [himg]; rfl)
  intro x hx hxS
  have : x ∈ S.left.image f := heq ▸ S.mem_gaps.2 hxS
  obtain ⟨y, hy, hyx⟩ := Finset.mem_image.1 this
  rw [mem_left] at hy
  simp only [hf] at hyx
  rw [show S.conductor - 1 - x = y by omega]
  exact hy.1

/-- Wilf's conjecture holds for symmetric numerical semigroups. -/
theorem IsSymmetric.wilf (h : S.IsSymmetric) : S.conductor ≤ S.embDim * S.ell :=
  S.wilf_of_conductor_le_two_mul_ell h.conductor_eq.le

/-! ### Apéry sets and Kunz coordinates -/

/-- `S.apery n i`: the least element of `S` congruent to `i` modulo `n` (for `0 < n`). -/
noncomputable def apery (n i : ℕ) : ℕ := sInf {s | s ∈ S ∧ s % n = i % n}

theorem exists_mem_mod_eq {n : ℕ} (hn : 0 < n) (i : ℕ) : ∃ s, s ∈ S ∧ s % n = i % n :=
  ⟨i + n * S.conductor, S.mem_of_conductor_le (by nlinarith), by simp⟩

theorem apery_spec {n : ℕ} (hn : 0 < n) (i : ℕ) :
    S.apery n i ∈ S ∧ S.apery n i % n = i % n :=
  Nat.sInf_mem (S.exists_mem_mod_eq hn i)

theorem apery_mem {n : ℕ} (hn : 0 < n) (i : ℕ) : S.apery n i ∈ S := (S.apery_spec hn i).1

theorem apery_mod {n : ℕ} (hn : 0 < n) (i : ℕ) : S.apery n i % n = i % n :=
  (S.apery_spec hn i).2

theorem apery_le {n i s : ℕ} (hs : s ∈ S) (hsi : s % n = i % n) : S.apery n i ≤ s :=
  Nat.sInf_le ⟨hs, hsi⟩

theorem apery_mod_self (n i : ℕ) : S.apery n (i % n) = S.apery n i := by
  simp [apery]

@[simp] theorem apery_zero (n : ℕ) : S.apery n 0 = 0 :=
  Nat.le_zero.1 (S.apery_le (zero_mem S) rfl)

/-- Membership via the Apéry set: for `n ∈ S`, `n > 0`, `x ∈ S ↔ w_{x mod n} ≤ x`. -/
theorem mem_iff_apery_le {n : ℕ} (hnS : n ∈ S) (hn : 0 < n) {x : ℕ} :
    x ∈ S ↔ S.apery n x ≤ x := by
  refine ⟨fun hx => S.apery_le hx rfl, fun hle => ?_⟩
  obtain ⟨k, hk⟩ : n ∣ x - S.apery n x :=
    Nat.dvd_of_mod_eq_zero (Nat.sub_mod_eq_zero_of_mod_eq (S.apery_mod hn x).symm)
  have : x = S.apery n x + k • n := by rw [smul_eq_mul, mul_comm]; omega
  rw [this]
  exact add_mem (S.apery_mem hn x) (nsmul_mem hnS k)

/-- Apéry elements are characterised by `w - n ∉ S`. -/
theorem apery_sub_not_mem {n : ℕ} (hn : 0 < n) (i : ℕ) (h : n ≤ S.apery n i) :
    S.apery n i - n ∉ S := by
  intro hm
  have h1 : (S.apery n i - n) % n = i % n := by
    rw [← S.apery_mod hn i]
    conv_rhs => rw [show S.apery n i = S.apery n i - n + n by omega]
    simp
  have := S.apery_le hm h1
  omega

theorem le_apery_of_lt {n i : ℕ} (hn : 0 < n) (hi : i < n) : i ≤ S.apery n i := by
  have h := S.apery_mod hn i
  rw [Nat.mod_eq_of_lt hi] at h
  calc i = S.apery n i % n := h.symm
    _ ≤ S.apery n i := Nat.mod_le _ _

/-- **Selmer's formula**: for `0 < n ∈ S`, `g(S) = ∑_{i<n} (w_i - i)/n` with `w_i = S.apery n i`. -/
theorem genus_eq_sum_apery {n : ℕ} (hnS : n ∈ S) (hn : 0 < n) :
    S.genus = ∑ i ∈ Finset.range n, (S.apery n i - i) / n := by
  rw [genus, Finset.card_eq_sum_card_fiberwise (f := fun x => x % n) (t := Finset.range n)
    (fun x _ => by simpa using Nat.mod_lt x hn)]
  refine Finset.sum_congr rfl fun i hi => ?_
  rw [Finset.mem_range] at hi
  set w := S.apery n i with hw
  have hwmod : w % n = i := by rw [hw, S.apery_mod hn, Nat.mod_eq_of_lt hi]
  have hwdecomp : w = i + n * (w / n) := by
    have := Nat.div_add_mod w n; rw [hwmod] at this; omega
  have hq : (w - i) / n = w / n := by
    rw [show w - i = n * (w / n) by omega, Nat.mul_div_cancel_left _ hn]
  rw [hq]
  have hfib : S.gaps.filter (fun x => x % n = i) =
      (Finset.range (w / n)).map ⟨fun k => i + n * k, fun a b h => by
        simp only at h
        exact Nat.eq_of_mul_eq_mul_left hn (by omega)⟩ := by
    ext x
    simp only [Finset.mem_filter, mem_gaps, Finset.mem_map, Finset.mem_range]
    rw [S.mem_iff_apery_le hnS hn (x := x)]
    constructor
    · rintro ⟨hlt, hxi⟩
      push Not at hlt
      have hax : S.apery n x = w := by rw [hw, ← S.apery_mod_self n x, hxi]
      rw [hax] at hlt
      refine ⟨x / n, ?_, ?_⟩
      · have hx := Nat.div_add_mod x n
        rw [hxi] at hx
        by_contra hge
        push Not at hge
        have := Nat.mul_le_mul_left n hge
        omega
      · show i + n * (x / n) = x
        have := Nat.div_add_mod x n; rw [hxi] at this; omega
    · rintro ⟨k, hk, hkx⟩
      have hkx' : i + n * k = x := hkx
      subst hkx'
      have hmod : (i + n * k) % n = i := by
        rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hi]
      refine ⟨?_, hmod⟩
      push Not
      have hax : S.apery n (i + n * k) = w := by
        rw [hw, ← S.apery_mod_self n (i + n * k), hmod]
      rw [hax]
      have := Nat.mul_lt_mul_of_pos_left hk hn
      omega
  rw [hfib, Finset.card_map, Finset.card_range]

/-- Kunz coordinate `x_i = (w_i - i)/m` with respect to the multiplicity `m`. -/
noncomputable def kunz (i : ℕ) : ℕ :=
  (S.apery S.multiplicity i - i) / S.multiplicity

/-- `g = ∑_{i<m} x_i` (Selmer's formula w.r.t. the multiplicity). -/
theorem genus_eq_sum_kunz :
    S.genus = ∑ i ∈ Finset.range S.multiplicity, S.kunz i :=
  S.genus_eq_sum_apery S.multiplicity_mem S.multiplicity_pos

end NumericalSemigroup

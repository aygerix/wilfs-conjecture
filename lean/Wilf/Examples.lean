import Wilf.Basic

/-!
# Kernel-checked examples

Three explicit numerical semigroups, each given by an explicit membership predicate, with all
invariants computed and the generating set identified via `closure_primitives`:

* `S357 = ⟨3,5,7⟩ = {0,3} ∪ [5,∞)`:      c = 5,  g = 3, ℓ = 2, m = 3, e = 3 (Wilf: 5 ≤ 6)
* `S469 = ⟨4,6,9⟩`, gaps {1,2,3,5,7,11}:  c = 12, g = 6, ℓ = 6, m = 4, e = 3 (Wilf: 12 ≤ 18)
* `S35  = ⟨3,5⟩` (symmetric):            c = 8,  g = 4, ℓ = 4, m = 3, e = 2 (Wilf: 8 ≤ 8, equality)

plus the boundary case `ℕ` (c = g = ℓ = 0, m = e = 1), treated in `Wilf.Basic`.
-/

namespace NumericalSemigroup.Examples

open NumericalSemigroup

/-! ### `⟨3,5,7⟩` -/

/-- `⟨3,5,7⟩ = {0,3} ∪ [5,∞)`. -/
def S357 : NumericalSemigroup :=
  ofPred (fun n => n = 0 ∨ n = 3 ∨ 5 ≤ n) (by omega) (by intro a b ha hb; omega) 5
    (by intro n hn; omega)

theorem mem_S357 {n : ℕ} : n ∈ S357 ↔ n = 0 ∨ n = 3 ∨ 5 ≤ n := Iff.rfl

theorem S357_conductor : S357.conductor = 5 := by
  rw [conductor_eq_iff]
  refine ⟨fun n hn => mem_S357.2 (by omega), fun _ h => ?_⟩
  rw [mem_S357] at h; omega

theorem S357_gaps : S357.gaps = {1, 2, 4} := by
  ext n; simp only [mem_gaps, mem_S357, Finset.mem_insert, Finset.mem_singleton]; omega

theorem S357_genus : S357.genus = 3 := by rw [genus, S357_gaps]; rfl

theorem S357_left : S357.left = {0, 3} := by
  ext n
  simp only [mem_left, S357_conductor, mem_S357, Finset.mem_insert, Finset.mem_singleton]
  omega

theorem S357_ell : S357.ell = 2 := by rw [ell, S357_left]; rfl

theorem S357_multiplicity : S357.multiplicity = 3 :=
  S357.multiplicity_eq_of (by omega) (mem_S357.2 (by omega))
    (fun n h0 h3 hn => by rw [mem_S357] at hn; omega)

theorem S357_primitives : S357.primitives = {3, 5, 7} := by
  ext n
  simp only [mem_primitives, Finset.mem_insert, Finset.mem_singleton]
  constructor
  · rintro ⟨hn, h0, h⟩
    rw [mem_S357] at hn
    by_contra hne
    exact h 3 (mem_S357.2 (by omega)) (n - 3) (mem_S357.2 (by omega)) (by omega) (by omega)
      (by omega)
  · intro hn
    refine ⟨mem_S357.2 (by omega), by omega, fun a ha b hb a0 b0 => ?_⟩
    rw [mem_S357] at ha hb
    omega

theorem S357_embDim : S357.embDim = 3 := by rw [embDim, S357_primitives]; rfl

/-- `S357` really is the submonoid generated by `{3,5,7}`. -/
theorem S357_eq_closure : S357.toAddSubmonoid = AddSubmonoid.closure {3, 5, 7} := by
  rw [← closure_primitives, S357_primitives]
  simp

theorem S357_wilf : S357.conductor ≤ S357.embDim * S357.ell := by
  rw [S357_conductor, S357_embDim, S357_ell]; norm_num

/-- Apéry set w.r.t. `3`: `w_1 = 7`, `w_2 = 5`; Selmer: `g = 0 + (7-1)/3 + (5-2)/3 = 3`. -/
theorem S357_apery_one : S357.apery 3 1 = 7 := by
  apply le_antisymm (S357.apery_le (mem_S357.2 (by omega)) (by norm_num))
  have h := S357.apery_spec (n := 3) (by norm_num) 1
  rw [mem_S357] at h
  omega

theorem S357_apery_two : S357.apery 3 2 = 5 := by
  apply le_antisymm (S357.apery_le (mem_S357.2 (by omega)) (by norm_num))
  have h := S357.apery_spec (n := 3) (by norm_num) 2
  rw [mem_S357] at h
  omega

theorem S357_selmer_check :
    ∑ i ∈ Finset.range 3, (S357.apery 3 i - i) / 3 = S357.genus := by
  rw [S357_genus, Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_one,
    apery_zero, S357_apery_one, S357_apery_two]

/-! ### `⟨4,6,9⟩` -/

/-- `⟨4,6,9⟩ = {0,4,6,8,9,10} ∪ [12,∞)`. -/
def S469 : NumericalSemigroup :=
  ofPred (fun n => n = 0 ∨ n = 4 ∨ n = 6 ∨ n = 8 ∨ n = 9 ∨ n = 10 ∨ 12 ≤ n) (by omega)
    (by intro a b ha hb; omega) 12 (by intro n hn; omega)

theorem mem_S469 {n : ℕ} :
    n ∈ S469 ↔ n = 0 ∨ n = 4 ∨ n = 6 ∨ n = 8 ∨ n = 9 ∨ n = 10 ∨ 12 ≤ n := Iff.rfl

theorem S469_conductor : S469.conductor = 12 := by
  rw [conductor_eq_iff]
  refine ⟨fun n hn => mem_S469.2 (by omega), fun _ h => ?_⟩
  rw [mem_S469] at h; omega

theorem S469_gaps : S469.gaps = {1, 2, 3, 5, 7, 11} := by
  ext n; simp only [mem_gaps, mem_S469, Finset.mem_insert, Finset.mem_singleton]; omega

theorem S469_genus : S469.genus = 6 := by rw [genus, S469_gaps]; rfl

theorem S469_left : S469.left = {0, 4, 6, 8, 9, 10} := by
  ext n
  simp only [mem_left, S469_conductor, mem_S469, Finset.mem_insert, Finset.mem_singleton]
  omega

theorem S469_ell : S469.ell = 6 := by rw [ell, S469_left]; rfl

theorem S469_multiplicity : S469.multiplicity = 4 :=
  S469.multiplicity_eq_of (by omega) (mem_S469.2 (by omega))
    (fun n h0 h4 hn => by rw [mem_S469] at hn; omega)

theorem S469_primitives : S469.primitives = {4, 6, 9} := by
  ext n
  simp only [mem_primitives, Finset.mem_insert, Finset.mem_singleton]
  constructor
  · rintro ⟨hn, h0, h⟩
    rw [mem_S469] at hn
    by_contra hne
    by_cases h15 : n = 15
    · exact h 6 (mem_S469.2 (by omega)) 9 (mem_S469.2 (by omega)) (by omega) (by omega)
        (by omega)
    · exact h 4 (mem_S469.2 (by omega)) (n - 4) (mem_S469.2 (by omega)) (by omega) (by omega)
        (by omega)
  · intro hn
    refine ⟨mem_S469.2 (by omega), by omega, fun a ha b hb a0 b0 => ?_⟩
    rw [mem_S469] at ha hb
    omega

theorem S469_embDim : S469.embDim = 3 := by rw [embDim, S469_primitives]; rfl

theorem S469_eq_closure : S469.toAddSubmonoid = AddSubmonoid.closure {4, 6, 9} := by
  rw [← closure_primitives, S469_primitives]
  simp

theorem S469_wilf : S469.conductor ≤ S469.embDim * S469.ell := by
  rw [S469_conductor, S469_embDim, S469_ell]; norm_num

/-! ### `⟨3,5⟩` (symmetric, Wilf equality) -/

/-- `⟨3,5⟩ = {0,3,5,6} ∪ [8,∞)`. -/
def S35 : NumericalSemigroup :=
  ofPred (fun n => n = 0 ∨ n = 3 ∨ n = 5 ∨ n = 6 ∨ 8 ≤ n) (by omega)
    (by intro a b ha hb; omega) 8 (by intro n hn; omega)

theorem mem_S35 {n : ℕ} : n ∈ S35 ↔ n = 0 ∨ n = 3 ∨ n = 5 ∨ n = 6 ∨ 8 ≤ n := Iff.rfl

theorem S35_conductor : S35.conductor = 8 := by
  rw [conductor_eq_iff]
  refine ⟨fun n hn => mem_S35.2 (by omega), fun _ h => ?_⟩
  rw [mem_S35] at h; omega

theorem S35_gaps : S35.gaps = {1, 2, 4, 7} := by
  ext n; simp only [mem_gaps, mem_S35, Finset.mem_insert, Finset.mem_singleton]; omega

theorem S35_genus : S35.genus = 4 := by rw [genus, S35_gaps]; rfl

theorem S35_left : S35.left = {0, 3, 5, 6} := by
  ext n
  simp only [mem_left, S35_conductor, mem_S35, Finset.mem_insert, Finset.mem_singleton]
  omega

theorem S35_ell : S35.ell = 4 := by rw [ell, S35_left]; rfl

theorem S35_primitives : S35.primitives = {3, 5} := by
  ext n
  simp only [mem_primitives, Finset.mem_insert, Finset.mem_singleton]
  constructor
  · rintro ⟨hn, h0, h⟩
    rw [mem_S35] at hn
    by_contra hne
    by_cases h10 : n = 10
    · exact h 5 (mem_S35.2 (by omega)) 5 (mem_S35.2 (by omega)) (by omega) (by omega)
        (by omega)
    · exact h 3 (mem_S35.2 (by omega)) (n - 3) (mem_S35.2 (by omega)) (by omega) (by omega)
        (by omega)
  · intro hn
    refine ⟨mem_S35.2 (by omega), by omega, fun a ha b hb a0 b0 => ?_⟩
    rw [mem_S35] at ha hb
    omega

theorem S35_embDim : S35.embDim = 2 := by rw [embDim, S35_primitives]; rfl

theorem S35_eq_closure : S35.toAddSubmonoid = AddSubmonoid.closure {3, 5} := by
  rw [← closure_primitives, S35_primitives]
  simp

theorem S35_isSymmetric : S35.IsSymmetric := by
  rw [isSymmetric_iff, S35_conductor, S35_ell]

/-- Equality case of Wilf: `c = e · ℓ = 8`. -/
theorem S35_wilf_eq : S35.conductor = S35.embDim * S35.ell := by
  rw [S35_conductor, S35_embDim, S35_ell]

end NumericalSemigroup.Examples

import Wilf.Carry
import Mathlib.Tactic.IntervalCases

/-!
# Kernel-checked examples

Three explicit numerical semigroups, each given by an explicit membership predicate, with all
invariants computed and the generating set identified via `closure_primitives`:

* `S357 = ⟨3,5,7⟩ = {0,3} ∪ [5,∞)`:      c = 5,  g = 3, ℓ = 2, m = 3, e = 3 (Wilf: 5 ≤ 6)
* `S469 = ⟨4,6,9⟩`, gaps {1,2,3,5,7,11}:  c = 12, g = 6, ℓ = 6, m = 4, e = 3 (Wilf: 12 ≤ 18)
* `S35  = ⟨3,5⟩` (symmetric):            c = 8,  g = 4, ℓ = 4, m = 3, e = 2 (Wilf: 8 ≤ 8, equality)

plus the boundary case `ℕ` (c = g = ℓ = 0, m = e = 1), treated in `Wilf.Basic`.
-/

namespace NumericalSemigroup.Examples

open NumericalSemigroup

/-! ### `⟨3,5,7⟩` -/

/-- `⟨3,5,7⟩ = {0,3} ∪ [5,∞)`. -/
def S357 : NumericalSemigroup :=
  ofPred (fun n => n = 0 ∨ n = 3 ∨ 5 ≤ n) (by omega) (by intro a b ha hb; omega) 5
    (by intro n hn; omega)

theorem mem_S357 {n : ℕ} : n ∈ S357 ↔ n = 0 ∨ n = 3 ∨ 5 ≤ n := Iff.rfl

theorem S357_conductor : S357.conductor = 5 := by
  rw [conductor_eq_iff]
  refine ⟨fun n hn => mem_S357.2 (by omega), fun _ h => ?_⟩
  rw [mem_S357] at h; omega

theorem S357_gaps : S357.gaps = {1, 2, 4} := by
  ext n; simp only [mem_gaps, mem_S357, Finset.mem_insert, Finset.mem_singleton]; omega

theorem S357_genus : S357.genus = 3 := by rw [genus, S357_gaps]; rfl

theorem S357_left : S357.left = {0, 3} := by
  ext n
  simp only [mem_left, S357_conductor, mem_S357, Finset.mem_insert, Finset.mem_singleton]
  omega

theorem S357_ell : S357.ell = 2 := by rw [ell, S357_left]; rfl

theorem S357_multiplicity : S357.multiplicity = 3 :=
  S357.multiplicity_eq_of (by omega) (mem_S357.2 (by omega))
    (fun n h0 h3 hn => by rw [mem_S357] at hn; omega)

theorem S357_primitives : S357.primitives = {3, 5, 7} := by
  ext n
  simp only [mem_primitives, Finset.mem_insert, Finset.mem_singleton]
  constructor
  · rintro ⟨hn, h0, h⟩
    rw [mem_S357] at hn
    by_contra hne
    exact h 3 (mem_S357.2 (by omega)) (n - 3) (mem_S357.2 (by omega)) (by omega) (by omega)
      (by omega)
  · intro hn
    refine ⟨mem_S357.2 (by omega), by omega, fun a ha b hb a0 b0 => ?_⟩
    rw [mem_S357] at ha hb
    omega

theorem S357_embDim : S357.embDim = 3 := by rw [embDim, S357_primitives]; rfl

/-- `S357` really is the submonoid generated by `{3,5,7}`. -/
theorem S357_eq_closure : S357.toAddSubmonoid = AddSubmonoid.closure {3, 5, 7} := by
  rw [← closure_primitives, S357_primitives]
  simp

theorem S357_wilf : S357.conductor ≤ S357.embDim * S357.ell := by
  rw [S357_conductor, S357_embDim, S357_ell]; norm_num

/-- Apéry set w.r.t. `3`: `w_1 = 7`, `w_2 = 5`; Selmer: `g = 0 + (7-1)/3 + (5-2)/3 = 3`. -/
theorem S357_apery_one : S357.apery 3 1 = 7 := by
  apply le_antisymm (S357.apery_le (mem_S357.2 (by omega)) (by norm_num))
  have h := S357.apery_spec (n := 3) (by norm_num) 1
  rw [mem_S357] at h
  omega

theorem S357_apery_two : S357.apery 3 2 = 5 := by
  apply le_antisymm (S357.apery_le (mem_S357.2 (by omega)) (by norm_num))
  have h := S357.apery_spec (n := 3) (by norm_num) 2
  rw [mem_S357] at h
  omega

theorem S357_selmer_check :
    ∑ i ∈ Finset.range 3, (S357.apery 3 i - i) / 3 = S357.genus := by
  rw [S357_genus, Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_one,
    apery_zero, S357_apery_one, S357_apery_two]

/-! ### `⟨4,6,9⟩` -/

/-- `⟨4,6,9⟩ = {0,4,6,8,9,10} ∪ [12,∞)`. -/
def S469 : NumericalSemigroup :=
  ofPred (fun n => n = 0 ∨ n = 4 ∨ n = 6 ∨ n = 8 ∨ n = 9 ∨ n = 10 ∨ 12 ≤ n) (by omega)
    (by intro a b ha hb; omega) 12 (by intro n hn; omega)

theorem mem_S469 {n : ℕ} :
    n ∈ S469 ↔ n = 0 ∨ n = 4 ∨ n = 6 ∨ n = 8 ∨ n = 9 ∨ n = 10 ∨ 12 ≤ n := Iff.rfl

theorem S469_conductor : S469.conductor = 12 := by
  rw [conductor_eq_iff]
  refine ⟨fun n hn => mem_S469.2 (by omega), fun _ h => ?_⟩
  rw [mem_S469] at h; omega

theorem S469_gaps : S469.gaps = {1, 2, 3, 5, 7, 11} := by
  ext n; simp only [mem_gaps, mem_S469, Finset.mem_insert, Finset.mem_singleton]; omega

theorem S469_genus : S469.genus = 6 := by rw [genus, S469_gaps]; rfl

theorem S469_left : S469.left = {0, 4, 6, 8, 9, 10} := by
  ext n
  simp only [mem_left, S469_conductor, mem_S469, Finset.mem_insert, Finset.mem_singleton]
  omega

theorem S469_ell : S469.ell = 6 := by rw [ell, S469_left]; rfl

theorem S469_multiplicity : S469.multiplicity = 4 :=
  S469.multiplicity_eq_of (by omega) (mem_S469.2 (by omega))
    (fun n h0 h4 hn => by rw [mem_S469] at hn; omega)

theorem S469_primitives : S469.primitives = {4, 6, 9} := by
  ext n
  simp only [mem_primitives, Finset.mem_insert, Finset.mem_singleton]
  constructor
  · rintro ⟨hn, h0, h⟩
    rw [mem_S469] at hn
    by_contra hne
    by_cases h15 : n = 15
    · exact h 6 (mem_S469.2 (by omega)) 9 (mem_S469.2 (by omega)) (by omega) (by omega)
        (by omega)
    · exact h 4 (mem_S469.2 (by omega)) (n - 4) (mem_S469.2 (by omega)) (by omega) (by omega)
        (by omega)
  · intro hn
    refine ⟨mem_S469.2 (by omega), by omega, fun a ha b hb a0 b0 => ?_⟩
    rw [mem_S469] at ha hb
    omega

theorem S469_embDim : S469.embDim = 3 := by rw [embDim, S469_primitives]; rfl

theorem S469_eq_closure : S469.toAddSubmonoid = AddSubmonoid.closure {4, 6, 9} := by
  rw [← closure_primitives, S469_primitives]
  simp

theorem S469_wilf : S469.conductor ≤ S469.embDim * S469.ell := by
  rw [S469_conductor, S469_embDim, S469_ell]; norm_num

/-! ### `⟨3,5⟩` (symmetric, Wilf equality) -/

/-- `⟨3,5⟩ = {0,3,5,6} ∪ [8,∞)`. -/
def S35 : NumericalSemigroup :=
  ofPred (fun n => n = 0 ∨ n = 3 ∨ n = 5 ∨ n = 6 ∨ 8 ≤ n) (by omega)
    (by intro a b ha hb; omega) 8 (by intro n hn; omega)

theorem mem_S35 {n : ℕ} : n ∈ S35 ↔ n = 0 ∨ n = 3 ∨ n = 5 ∨ n = 6 ∨ 8 ≤ n := Iff.rfl

theorem S35_conductor : S35.conductor = 8 := by
  rw [conductor_eq_iff]
  refine ⟨fun n hn => mem_S35.2 (by omega), fun _ h => ?_⟩
  rw [mem_S35] at h; omega

theorem S35_gaps : S35.gaps = {1, 2, 4, 7} := by
  ext n; simp only [mem_gaps, mem_S35, Finset.mem_insert, Finset.mem_singleton]; omega

theorem S35_genus : S35.genus = 4 := by rw [genus, S35_gaps]; rfl

theorem S35_left : S35.left = {0, 3, 5, 6} := by
  ext n
  simp only [mem_left, S35_conductor, mem_S35, Finset.mem_insert, Finset.mem_singleton]
  omega

theorem S35_ell : S35.ell = 4 := by rw [ell, S35_left]; rfl

theorem S35_primitives : S35.primitives = {3, 5} := by
  ext n
  simp only [mem_primitives, Finset.mem_insert, Finset.mem_singleton]
  constructor
  · rintro ⟨hn, h0, h⟩
    rw [mem_S35] at hn
    by_contra hne
    by_cases h10 : n = 10
    · exact h 5 (mem_S35.2 (by omega)) 5 (mem_S35.2 (by omega)) (by omega) (by omega)
        (by omega)
    · exact h 3 (mem_S35.2 (by omega)) (n - 3) (mem_S35.2 (by omega)) (by omega) (by omega)
        (by omega)
  · intro hn
    refine ⟨mem_S35.2 (by omega), by omega, fun a ha b hb a0 b0 => ?_⟩
    rw [mem_S35] at ha hb
    omega

theorem S35_embDim : S35.embDim = 2 := by rw [embDim, S35_primitives]; rfl

theorem S35_eq_closure : S35.toAddSubmonoid = AddSubmonoid.closure {3, 5} := by
  rw [← closure_primitives, S35_primitives]
  simp

theorem S35_isSymmetric : S35.IsSymmetric := by
  rw [isSymmetric_iff, S35_conductor, S35_ell]

/-- Equality case of Wilf: `c = e · ℓ = 8`. -/
theorem S35_wilf_eq : S35.conductor = S35.embDim * S35.ell := by
  rw [S35_conductor, S35_embDim, S35_ell]


/-! ### TOP'' evaluated on two examples (sanity check of the `Wilf.Chains` definitions) -/

theorem S35_multiplicity : S35.multiplicity = 3 :=
  S35.multiplicity_eq_of (by omega) (mem_S35.2 (by omega))
    (fun n h0 h3 hn => by rw [mem_S35] at hn; omega)

theorem S35_aperySet : S35.aperySet 3 = {0, 10, 5} := by
  ext w
  rw [mem_aperySet (mem_S35.2 (by omega)) (by omega), IsApery, mem_S35, mem_S35]
  simp only [Finset.mem_insert, Finset.mem_singleton]
  omega

theorem S35_topLayer : S35.topLayer = {10} := by
  ext u
  rw [mem_topLayer, S35_multiplicity, S35_aperySet, S35_conductor]
  simp only [Finset.mem_insert, Finset.mem_singleton]
  omega

theorem S35_primitives' : S35.primitives' = {5} := by
  rw [primitives', S35_primitives, S35_multiplicity]; decide

theorem S35_minFactLen_ten : S35.minFactLen 10 = 2 := by
  apply le_antisymm
  · have := minFactLen_le (S := S35) (u := 10) (f := fun _ => 2) (by rw [S35_primitives']; rfl)
    rwa [S35_primitives'] at this
  · have hA : S35.IsApery S35.multiplicity 10 := by
      rw [S35_multiplicity, ← mem_aperySet (mem_S35.2 (by omega)) (by omega), S35_aperySet]
      simp
    obtain ⟨f, hf, hlen⟩ := minFactLen_spec hA
    rw [S35_primitives', Finset.sum_singleton] at hf hlen
    omega

/-- `⟨3,5⟩` (`W = 0`): TOP'' holds with equality, `9 = 9`. -/
theorem S35_TOP2_eq :
    ∑ u ∈ S35.topLayer, (u - S35.conductor + 1) * ((S35.embDim - 1) + S35.minFactLen u) = 9 ∧
    S35.multiplicity * ((S35.embDim - 1 + 1) * S35.multiplicity + (S35.embDim - 1) - 1) / 2 = 9 := by
  rw [S35_topLayer, Finset.sum_singleton, S35_conductor, S35_embDim, S35_minFactLen_ten,
    S35_multiplicity]
  decide

theorem S35_TOP2 : S35.TOP2 := by
  rw [TOP2, S35_TOP2_eq.1, S35_TOP2_eq.2]

theorem S357_aperySet : S357.aperySet 3 = {0, 7, 5} := by
  ext w
  rw [mem_aperySet (mem_S357.2 (by omega)) (by omega), IsApery, mem_S357, mem_S357]
  simp only [Finset.mem_insert, Finset.mem_singleton]
  omega

theorem S357_topLayer : S357.topLayer = {7, 5} := by
  ext u
  rw [mem_topLayer, S357_multiplicity, S357_aperySet, S357_conductor]
  simp only [Finset.mem_insert, Finset.mem_singleton]
  omega

theorem S357_primitives' : S357.primitives' = {5, 7} := by
  rw [primitives', S357_primitives, S357_multiplicity]; decide

theorem S357_minFactLen {u : ℕ} (hu : u = 5 ∨ u = 7) : S357.minFactLen u = 1 := by
  have hA : S357.IsApery S357.multiplicity u := by
    rw [S357_multiplicity, ← mem_aperySet (mem_S357.2 (by omega)) (by omega), S357_aperySet]
    rcases hu with rfl | rfl <;> simp
  obtain ⟨f, hf, hlen⟩ := minFactLen_spec hA
  rw [S357_primitives', Finset.sum_pair (by norm_num)] at hf hlen
  omega

/-- `⟨3,5,7⟩` (`W = 1`): TOP'' reads `12 ≤ 15`. -/
theorem S357_TOP2_vals :
    ∑ u ∈ S357.topLayer, (u - S357.conductor + 1) * ((S357.embDim - 1) + S357.minFactLen u) = 12 ∧
    S357.multiplicity * ((S357.embDim - 1 + 1) * S357.multiplicity + (S357.embDim - 1) - 1) / 2
      = 15 := by
  rw [S357_topLayer, Finset.sum_pair (by norm_num), S357_conductor, S357_embDim,
    S357_minFactLen (Or.inl rfl), S357_minFactLen (Or.inr rfl), S357_multiplicity]
  decide

theorem S357_TOP2 : S357.TOP2 := by
  rw [TOP2, S357_TOP2_vals.1, S357_TOP2_vals.2]; norm_num


/-! ### Tile-CL sanity checks (`decide` only; no `native_decide`) -/

theorem vec2_eta (y : Fin 2 → ℕ) : y = ![y 0, y 1] := by
  funext i; fin_cases i <;> rfl

theorem vec1_eta (y : Fin 1 → ℕ) : y = ![y 0] := by
  funext i; fin_cases i; rfl

/-- Tile 1: `d = 2`, `D = {00, 01, 10}`, `m = 3`, `p = (1, 2)`. -/
def tile1D : Finset (Fin 2 → ℕ) := {![0, 0], ![0, 1], ![1, 0]}
/-- Tile 1 weights. -/
def tile1p : Fin 2 → ZMod 3 := ![1, 2]

theorem tile1_downset : IsDownSetFin tile1D := by
  intro x hx y hy
  have h0 := hy 0
  have h1 := hy 1
  rw [vec2_eta y]
  generalize y 0 = a at h0
  generalize y 1 = b at h1
  simp only [tile1D, Finset.mem_insert, Finset.mem_singleton] at hx
  rcases hx with rfl | rfl | rfl <;>
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one] at h0 h1 <;>
    interval_cases a <;> interval_cases b <;> decide

theorem tile1_isTile : IsTile tile1D tile1p :=
  IsTile.mk' tile1_downset (by decide) (by decide) (by decide)

theorem tile1_TileCLAt : TileCLAt tile1D tile1p := by unfold TileCLAt; decide

/-- Tile 1 is tight at `s = 2`: `f(2) = 3 = (d-1)·m(m-1)/2`. -/
theorem tile1_tight : ∑ y ∈ tile1D, tileT tile1D y * ((2 : ZMod 3) - tilePhi tile1p y).val = 3 := by
  decide

/-- Tile 2: `d = 1`, a single column `D = {0, 1, 2}`, `m = 3`, `p = (1)`. -/
def tile2D : Finset (Fin 1 → ℕ) := {![0], ![1], ![2]}
/-- Tile 2 weights. -/
def tile2p : Fin 1 → ZMod 3 := ![1]

theorem tile2_downset : IsDownSetFin tile2D := by
  intro x hx y hy
  have h0 := hy 0
  rw [vec1_eta y]
  generalize y 0 = a at h0
  simp only [tile2D, Finset.mem_insert, Finset.mem_singleton] at hx
  rcases hx with rfl | rfl | rfl <;>
    simp only [Matrix.cons_val_fin_one] at h0 <;>
    interval_cases a <;> decide

theorem tile2_isTile : IsTile tile2D tile2p :=
  IsTile.mk' tile2_downset (by decide) (by decide) (by decide)

theorem tile2_TileCLAt : TileCLAt tile2D tile2p := by unfold TileCLAt; decide

/-- Tile 3: `d = 2`, box `{0,1,2} × {0,1}`, `m = 6`, `p = (2, 1)` ("perfect" tile, tight at `s = -1`). -/
def tile3D : Finset (Fin 2 → ℕ) := {![0, 0], ![1, 0], ![2, 0], ![0, 1], ![1, 1], ![2, 1]}
/-- Tile 3 weights. -/
def tile3p : Fin 2 → ZMod 6 := ![2, 1]

theorem tile3_downset : IsDownSetFin tile3D := by
  intro x hx y hy
  have h0 := hy 0
  have h1 := hy 1
  rw [vec2_eta y]
  generalize y 0 = a at h0
  generalize y 1 = b at h1
  simp only [tile3D, Finset.mem_insert, Finset.mem_singleton] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one] at h0 h1 <;>
    interval_cases a <;> interval_cases b <;> decide

theorem tile3_isTile : IsTile tile3D tile3p :=
  IsTile.mk' tile3_downset (by decide) (by decide) (by decide)

theorem tile3_TileCLAt : TileCLAt tile3D tile3p := by unfold TileCLAt; decide

/-- Tile 3 is tight at `s = 5 = -1`: `f(5) = 15 = (d-1)·m(m-1)/2`. -/
theorem tile3_tight :
    ∑ y ∈ tile3D, tileT tile3D y * ((5 : ZMod 6) - tilePhi tile3p y).val = 15 := by
  decide

end NumericalSemigroup.Examples
